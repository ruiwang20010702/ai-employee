{
  "version": 1,
  "projectId": "example_project",
  "name": "示例项目",
  "rootDirectory": "/absolute/path/to/project",
  "requesters": ["replace_with_authorized_user_id"],
  "profile": {
    "objective": "用可验证的工作配方推进本项目并减少重复劳动",
    "successCriteria": ["每项工作都有来源、状态和验收证据"],
    "milestones": ["完成第一次影子配方运行"],
    "collaborationObjects": [],
    "selectedRecipeIds": ["project-follow-up"],
    "memoryScope": {
      "allowedTypes": ["project", "principle"],
      "retentionDays": 90
    }
  },
  "capabilities": {
    "knowledge_read": {
      "mode": "disabled"
    },
    "research": { "mode": "automatic", "timeoutMs": 120000 },
    "document_draft": { "mode": "automatic", "timeoutMs": 120000 },
    "project_memory_proposal": {
      "mode": "disabled",
      "allowedFactKeyPrefixes": ["decision.", "risk.", "milestone."],
      "maxRetentionDays": 90,
      "maxRuns": 3
    },
    "shared_document_write": {
      "mode": "approval_required",
      "folderNodeId": "replace_with_fixed_document_folder_node_id",
      "maxContentBytes": 204800,
      "maxRuns": 1,
      "timeoutMs": 120000
    },
    "dingtalk_todo_create": {
      "mode": "disabled"
    },
    "dingtalk_calendar_create": {
      "mode": "disabled"
    },
    "dingtalk_report_submit": {
      "mode": "disabled"
    },
    "code_patch": { "mode": "approval_required", "timeoutMs": 600000 },
    "local_branch": { "mode": "approval_required", "maxRuns": 1 },
    "local_test": {
      "mode": "approval_required",
      "timeoutMs": 600000,
      "commands": {
        "项目检查": {
          "executable": "/absolute/path/to/npm",
          "args": ["run", "check"],
          "timeoutMs": 600000,
          "maxOutputBytes": 1048576
        }
      }
    },
    "git_push": {
      "mode": "approval_required",
      "maxRuns": 1,
      "timeoutMs": 120000,
      "remote": "origin",
      "expectedRemoteUrl": "https://github.com/example/ai-employee-project.git",
      "branchPrefix": "foursday/"
    },
    "github_pr_draft": {
      "mode": "disabled",
      "repository": "owner/repository",
      "baseBranches": ["main"],
      "maxTitleChars": 120,
      "maxBodyBytes": 65536,
      "maxRuns": 1
    },
    "production_deploy": {
      "mode": "approval_required",
      "maxRuns": 1,
      "commands": {
        "生产发布": {
          "executable": "/absolute/path/to/project-release-script",
          "args": ["deploy"],
          "timeoutMs": 900000,
          "maxOutputBytes": 1048576
        },
        "发布验收": {
          "executable": "/absolute/path/to/project-release-script",
          "args": ["verify"],
          "timeoutMs": 120000,
          "maxOutputBytes": 1048576
        },
        "发布回滚": {
          "executable": "/absolute/path/to/project-release-script",
          "args": ["rollback"],
          "timeoutMs": 600000,
          "maxOutputBytes": 1048576
        }
      }
    }
  }
}
