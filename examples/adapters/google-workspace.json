{
  "version": 1,
  "id": "google-workspace",
  "name": "Google Workspace reference adapter",
  "platform": "google-workspace",
  "contract": "workspace_adapter",
  "contractVersion": "1.0",
  "status": "reference",
  "permissions": ["calendar.events", "drive.file", "tasks"],
