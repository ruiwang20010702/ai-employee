#!/usr/bin/expect -f

set timeout 15
set service [lindex $argv 0]
set account [lindex $argv 1]
fconfigure stdin -translation binary -encoding binary
set secret [read stdin]
if {[string length $secret] == 0} {
    exit 1
}

spawn -noecho /usr/bin/security add-generic-password -s $service -a $account -w
expect {
    -re {(password data|retype password).*:} {
        send -raw -- $secret
        send -- "\r"
        exp_continue
    }
    eof {
        set result [wait]
        exit [lindex $result 3]
    }
    timeout {
        exit 1
    }
}
