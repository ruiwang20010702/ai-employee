# 必填：一个或多个允许监听的联系人 userId，多个用逗号分隔
DINGTALK_TARGET_USER_IDS=example_user_id

# 启用发送能力时必填，用于检测负责人是否已经人工回复
DINGTALK_SELF_USER_ID=example_self_user_id

# 生产必填：PostgreSQL、租户和固定加密密钥
DATABASE_URL=postgresql://ai_employee:change_me@127.0.0.1:5432/ai_employee
DATABASE_SSL=false
DATABASE_POOL_MAX=10
AI_EMPLOYEE_TENANT_ID=example_tenant
# base64 编码的 32 字节密钥，必须由密钥管理系统注入并保持不变
AI_EMPLOYEE_DATA_KEY=
# 必须与数据密钥不同
AI_EMPLOYEE_BACKUP_KEY=
AI_EMPLOYEE_BACKUP_DIRECTORY=/absolute/path/to/backups

# 运行参数
DINGTALK_DEBOUNCE_MS=800
DINGTALK_FALLBACK_MS=300000
DINGTALK_QUIET_WINDOW_MS=3000
AI_EMPLOYEE_BUNDLE_MAX_WAIT_MS=8000
DINGTALK_INITIAL_LOOKBACK_HOURS=72
DINGTALK_FETCH_OVERLAP_MS=600000
DWS_PATH=/absolute/path/to/dws
DWS_MOCK=false
CODEX_PATH=/absolute/path/to/codex
AI_EMPLOYEE_WORKER_POLL_MS=2000
AI_EMPLOYEE_MAX_TASK_ATTEMPTS=5
AI_EMPLOYEE_WAITING_INFORMATION_TTL_MS=86400000
AI_EMPLOYEE_SHADOW_MIN_SAMPLES=100
AI_EMPLOYEE_SHADOW_MIN_REPLY_ACCURACY=0.95
AI_EMPLOYEE_SHADOW_MIN_NO_REPLY_ACCURACY=0.95
AI_EMPLOYEE_SHADOW_MIN_DRAFT_SAMPLES=30
AI_EMPLOYEE_SHADOW_MIN_DRAFT_USABILITY=0.9
AI_EMPLOYEE_HEARTBEAT_MS=30000
AI_EMPLOYEE_HEARTBEAT_STALE_MS=90000
AI_EMPLOYEE_REQUIRED_COMPONENTS=listener,worker
AI_EMPLOYEE_HEALTH_HOST=127.0.0.1
AI_EMPLOYEE_HEALTH_PORT=9464
# 健康服务监听非本机地址时必填
AI_EMPLOYEE_HEALTH_AUTH_TOKEN=

# 默认只能生成草稿；真实发送必须显式加入 send_message
AI_EMPLOYEE_ALLOWED_CAPABILITIES=draft_reply
AI_EMPLOYEE_APPROVER=local-user
