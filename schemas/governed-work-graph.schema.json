{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foursday.dev/schemas/governed-work-graph-v1.json",
  "title": "Foursday Governed Work Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["graphVersion", "nodes", "edges"],
  "properties": {
    "graphVersion": { "const": 1 },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "digestId": {
      "type": "string",
      "pattern": "^[a-z]+_[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "recordId", "recordVersion"],
      "properties": {
        "recordType": { "type": "string", "minLength": 1, "maxLength": 100 },
        "recordId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "recordVersion": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphVersion", "tenantId", "projectId", "nodeType", "domainId",
        "revision", "provenance", "sensitivity", "expiresAt", "observedAt",
        "nodeKey", "nodeId"
      ],
      "properties": {
        "graphVersion": { "const": 1 },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "nodeType": {
          "enum": [
            "approval", "audit", "authorization", "capability", "deliverable",
            "event", "evidence", "memory", "message", "outcome", "person",
            "plan", "project", "recipe", "source", "step", "task",
            "time_return", "trigger"
          ]
        },
        "domainId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 500 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "sensitivity": { "enum": ["public", "internal", "confidential"] },
        "expiresAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "nodeKey": { "$ref": "#/$defs/digestId" },
        "nodeId": { "$ref": "#/$defs/digestId" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphVersion", "edgeType", "from", "to", "phase", "provenance",
        "authorizationHash", "sensitivity", "expiresAt", "validFrom",
        "invalidatedAt", "state", "observedAt", "relationKey", "edgeId"
      ],
      "properties": {
        "graphVersion": { "const": 1 },
        "edgeType": {
          "enum": [
            "project.has_authorization", "project.selects_recipe",
            "event.matches_trigger", "trigger.instantiates_plan",
            "task.requests_plan", "plan.contains_step",
            "recipe.instantiates_plan", "authorization.grants_capability",
            "authorization.permits_step", "step.uses_capability",
            "approval.authorizes_plan", "step.produces_evidence",
            "plan.produces_outcome", "source.supports_memory",
            "memory.informs_plan", "plan.proposes_time_return", "plan.proposes_memory",
            "plan.supersedes_plan"
          ]
        },
        "from": { "$ref": "#/$defs/nodeReference" },
        "to": { "$ref": "#/$defs/nodeReference" },
        "phase": { "enum": ["intended", "runtime"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "authorizationHash": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "sensitivity": { "enum": ["public", "internal", "confidential"] },
        "expiresAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "validFrom": { "$ref": "#/$defs/timestamp" },
        "invalidatedAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "state": { "enum": ["active", "invalidated"] },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "relationKey": { "$ref": "#/$defs/digestId" },
        "edgeId": { "$ref": "#/$defs/digestId" }
      }
    },
    "nodeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphVersion", "tenantId", "projectId", "nodeType", "domainId",
        "revision", "sensitivity", "expiresAt", "nodeKey", "nodeId"
      ],
      "properties": {
        "graphVersion": { "const": 1 },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "nodeType": { "$ref": "#/$defs/node/properties/nodeType" },
        "domainId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sensitivity": { "enum": ["public", "internal", "confidential"] },
        "expiresAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "nodeKey": { "$ref": "#/$defs/digestId" },
        "nodeId": { "$ref": "#/$defs/digestId" }
      }
    }
  }
}
