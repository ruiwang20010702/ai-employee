{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["shouldReply", "reply", "confidence", "riskLevel", "reason", "workRequest"],
  "properties": {
    "shouldReply": {
      "type": "boolean"
    },
    "reply": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "reason": {
      "type": "string"
    },
    "workRequest": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "objective", "projectHint"],
          "properties": {
            "requested": { "type": "boolean" },
            "objective": { "type": "string" },
            "projectHint": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    }
  }
}
